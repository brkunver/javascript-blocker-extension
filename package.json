{
  "name": "javascript-blocker-extension",
  "description": "Block user defined javascript on websites",
  "author": "burakhanunver@gmail.com",
  "private": false,
  "version": "2.3.1",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip:all": "bun run --parallel zip zip:firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:edge": "wxt zip -b edge",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "postinstall": "wxt prepare",
    "manager": "bun manager.cjs bun"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/svelte": "^5.0.8",
    "@wxt-dev/module-svelte": "^2.0.5",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "wxt": "^0.21.4"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "esbuild",
    "spawn-sync"
  ],
  "dependencies": {
    "@wxt-dev/i18n": "^0.2.7"
  }
}
